@using TaskTrackerPro.Service.Entities.TaskItemAggregate
@using TaskTrackerPro.Web.ViewModels
@using TaskTrackerPro.Service.Interfaces

@inject ITaskService _taskService

<EditForm Model="_taskItemViewModel" OnValidSubmit="HandleValidSubmit">

    <DataAnnotationsValidator />

    <div class="mb-3">
        <label>Title</label>
        <InputText class="form-control" @bind-Value="_taskItemViewModel.Title" />
        <ValidationMessage For="@(() => _taskItemViewModel.Title)" />
    </div>
    <div class="mb-3">
        <label>Description</label>
        <InputTextArea class="form-control" @bind-Value="_taskItemViewModel.Description" />
        <ValidationMessage For="@(() => _taskItemViewModel.Description)" />
    </div>
    <div class="mb-3">
        <label>Priority</label>
        <InputSelect class="form-select" @bind-Value="_taskItemViewModel.TaskItemPriority">
            @foreach (var priority in Enum.GetValues<TaskItemPriority>())
            {
                <option value="@priority">@priority</option>
            }
        </InputSelect>
        <ValidationMessage For="@(() => _taskItemViewModel.TaskItemPriority)" />
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
</EditForm>
