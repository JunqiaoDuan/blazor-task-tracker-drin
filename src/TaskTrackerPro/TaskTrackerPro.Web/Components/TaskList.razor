@using TaskTrackerPro.Service.Interfaces
@using TaskTrackerPro.Web.ViewModels
@using TaskTrackerPro.Service.Entities.TaskItemAggregate

@inject ITaskService _taskService

<div class="mb-3 d-flex flex-row align-items-center">
    <button class="btn btn-primary" @onclick="openAddModal">
        Add Task
    </button>
</div>
<div class="mb-3 d-flex flex-row align-items-center justify-content-between">
    <div class="d-flex flex-row gap-2 align-items-center">
        <InputText class="form-control" @bind-Value="_taskItemViewModel.TitleFilter" placeholder="Title" />
        <InputText class="form-control" @bind-Value="_taskItemViewModel.DescriptionFilter" placeholder="Description" />
        <InputSelect class="form-select" @bind-Value="_taskItemViewModel.StatusFilter">
            <option value="">All</option>
            @foreach (var status in Enum.GetValues<TaskItemStatus>())
            {
                <option value="@status">@status</option>
            }
        </InputSelect>
        <InputSelect class="form-select" @bind-Value="_taskItemViewModel.PriorityFilter">
            <option value="">All</option>
            @foreach (var priority in Enum.GetValues<TaskItemPriority>())
            {
                <option value="@priority">@priority</option>
            }
        </InputSelect>
    </div>
    <div class="d-flex flex-row gap-2">
        <button class="btn btn-outline-primary" @onclick="onSearchClicked">
            Search
        </button>
        <button class="btn btn-outline-secondary" @onclick="onClearClicked">
            Clear
        </button>
    </div>
</div>

@if (_isLoading)
{
    <div class="text-center my-4">
        <span class="spinner-border" role="status"></span>
        <span class="ms-2">Loading tasks...</span>
    </div>
}
else if (_taskItemViewModel.Records == null || !_taskItemViewModel.Records.Any())
{
    <div class="alert alert-info mt-3">
        No tasks found.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Title</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th>Priority</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var _task in _taskItemViewModel.Records)
                {
                    <tr>
                        <td>@_task.Title</td>
                        <td>@_task.Description</td>
                        <td>
                            <span class="@getStatusBadge(_task.TaskItemStatus)">
                                @_task.TaskItemStatus
                            </span>
                        </td>
                        <td>
                            <span class="@getPriorityBadge(_task.TaskItemPriority)">
                                @_task.TaskItemPriority
                            </span>
                        </td>
                        <td>@_task.CreationDate?.ToString("g")</td>
                        <td>
                            <button class="btn btn-sm btn-outline-success" @onclick="() => toggleCompletionClicked(_task.Id)">
                                Complete
                            </button>
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => openEditModalClicked(_task.Id)">
                                Edit
                            </button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => openDeleteTaskClicked(_task.Id)">
                                Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_showEditModal)
{
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@((_editingTaskId == null) ? "Add Task" : "Edit Task")</h5>
                    <button type="button" class="btn-close" @onclick="closeEditModal"></button>
                </div>
                <div class="modal-body">
                    <TaskForm TaskItemId="_editingTaskId" OnSaved="onTaskSavedAsync" OnCancel="closeEditModal" />
                </div>
            </div>
        </div>
    </div>
}