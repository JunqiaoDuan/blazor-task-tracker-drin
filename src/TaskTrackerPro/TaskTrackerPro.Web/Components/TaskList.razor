@using TaskTrackerPro.Service.Interfaces
@using TaskTrackerPro.Web.ViewModels
@using TaskTrackerPro.Service.Entities.TaskItemAggregate

@inject ITaskService _taskService

<button class="btn btn-primary mb-3" @onclick="openAddModal">
    Add Task
</button>

@if (_isLoading)
{
    <div class="text-center my-4">
        <span class="spinner-border" role="status"></span>
        <span class="ms-2">Loading tasks...</span>
    </div>
}
else if (_taskItemViewModel.Records == null || !_taskItemViewModel.Records.Any())
{
    <div class="alert alert-info mt-3">
        No tasks found.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Title</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th>Priority</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var _task in _taskItemViewModel.Records)
                {
                    <tr>
                        <td>@_task.Title</td>
                        <td>@_task.Description</td>
                        <td>
                            <span class="@getStatusBadge(_task.Status)">
                                @_task.Status
                            </span>
                        </td>
                        <td>
                            <span class="@getPriorityBadge(_task.Priority)">
                                @_task.Priority
                            </span>
                        </td>
                        <td>@_task.CreatedAt.ToString("g")</td>
                        <td>
                            <button class="btn btn-sm btn-outline-success me-1">
                                <i class="bi bi-check2-circle">
                                    Toggle Complete
                                </i>
                            </button>
                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => openEditModal()">
                                <i class="bi bi-pencil">
                                    Edit
                                </i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash">
                                    Delete
                                </i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_showEditModal)
{
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@((_editingTaskId == null) ? "Add Task" : "Edit Task")</h5>
                    <button type="button" class="btn-close" @onclick="closeEditModal"></button>
                </div>
                <div class="modal-body">
                    <TaskEdit TaskItemId="_editingTaskId" OnSaved="onTaskSavedAsync" OnCancel="closeEditModal" />
                </div>
            </div>
        </div>
    </div>
}